# Copia a .env.local y rellena con tu proyecto Supabase.
# Ver SETUP.md

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pública de la app (local o Vercel). Usada en magic link y QR.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Emails de dueño/staff (separados por comas). El callback les asigna rol admin.
ADMIN_EMAILS=tu@email.com
